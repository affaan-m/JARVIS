# Frontend
NEXT_PUBLIC_CONVEX_URL=

# Backend
JARVIS_ENV=development
JARVIS_FRONTEND_ORIGIN=http://localhost:3000
JARVIS_API_PORT=8000
JARVIS_LOG_LEVEL=INFO
# Opt-in hunters game for colleagues who join themselves (also togglable in the UI)
JARVIS_GAME_MODE=false

# Service integrations
CONVEX_URL=
MONGODB_URI=
EXA_API_KEY=
# Search Exa's people index first for name lookups (falls back to web search)
EXA_PEOPLE_SEARCH=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NVIDIA API catalog — get a key (nvapi-...) at https://build.nvidia.com
# Multiple keys: separate with commas (nvapi-aaa,nvapi-bbb). They are used
# round-robin; a key hitting a rate limit (429) is skipped for 60s.
# Used for dossier synthesis when ANTHROPIC_API_KEY is empty (else as fallback),
# and for browser agents when BROWSER_USE_API_KEY and OPENAI_API_KEY are empty.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Optional: several models (comma-separated), rotated together with the keys.
# Overrides NVIDIA_MODEL. An unknown model is skipped for an hour.
NVIDIA_MODELS=
# Optional: different model for the browser agents (defaults to NVIDIA_MODEL)
NVIDIA_AGENT_MODEL=
# Gemini — several keys and/or models (comma-separated) are rotated round-robin.
# A key/model pair that hits a quota (429) is skipped for 60s; an unknown model
# or rejected key for an hour.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-2.5-flash-lite
TELEGRAM_BOT_TOKEN=
PIMEYES_ACCOUNT_POOL=[]

# Laminar observability — get your key at https://www.lmnr.ai
# Config reads LAMINAR_API_KEY; the SDK receives it via Laminar.initialize()
LAMINAR_API_KEY=

# Browser Use v2 cloud — get your key at https://cloud.browser-use.com/new-api-key
# When set, agents use cloud browser sessions with persistent auth.
# To set up authenticated sessions:
#   1. Set this key
#   2. Run `browseruse` CLI interactively
#   3. Log into LinkedIn, Twitter, Instagram manually
#   4. Sessions persist in your Browser Use cloud profile
BROWSER_USE_API_KEY=

# SuperMemory — long-term memory / dossier cache for the pipeline
# Get your key at https://supermemory.ai
SUPERMEMORY_API_KEY=
